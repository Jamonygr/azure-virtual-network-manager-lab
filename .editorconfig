root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{tf,tfvars,hcl}]
indent_style = space
indent_size = 2

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.{ps1,psm1}]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

